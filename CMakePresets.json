{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "YOUR_LIBRARY_BUILD_SHARED": "ON",
                "YOUR_LIBRARY_BUILD_STATIC": "ON",
                "YOUR_LIBRARY_BUILD_TESTS": "ON",
                "YOUR_LIBRARY_ENABLE_WARNINGS": "ON",
                "YOUR_LIBRARY_ENABLE_WERROR": "OFF",
                "YOUR_LIBRARY_ENABLE_SANITIZERS": "OFF",
                "YOUR_LIBRARY_MINGW_STATIC_RUNTIME": "ON"
            }
        },
        {
            "name": "ninja-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja"
        },
        {
            "name": "vcpkg-base",
            "hidden": true,
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
            }
        },
        {
            "name": "dev-debug",
            "displayName": "Developer Debug",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "YOUR_LIBRARY_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "dev-release",
            "displayName": "Developer Release",
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vcpkg-debug",
            "displayName": "Developer Debug (vcpkg)",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "YOUR_LIBRARY_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "vcpkg-release",
            "displayName": "Developer Release (vcpkg)",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux GCC Debug",
            "inherits": "dev-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/usr/bin/g++"
            }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug",
            "inherits": "dev-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
            }
        },
        {
            "name": "linux-gcc-vcpkg-debug",
            "displayName": "Linux GCC Debug (vcpkg)",
            "inherits": "vcpkg-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "VCPKG_TARGET_TRIPLET": "x64-linux-gcc"
            }
        },
        {
            "name": "linux-clang-vcpkg-debug",
            "displayName": "Linux Clang Debug (vcpkg)",
            "inherits": "vcpkg-debug",
            "condition": {
                "type": "equals",
