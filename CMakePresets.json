{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "LIB_FMU_TOOLKIT_BUILD_SHARED": "ON",
                "LIB_FMU_TOOLKIT_BUILD_STATIC": "ON",
                "LIB_FMU_TOOLKIT_BUILD_TESTS": "ON",
                "LIB_FMU_TOOLKIT_BUILD_EXAMPLES": "ON",
                "LIB_FMU_TOOLKIT_ENABLE_WARNINGS": "ON",
                "LIB_FMU_TOOLKIT_ENABLE_WERROR": "OFF",
                "LIB_FMU_TOOLKIT_ENABLE_SANITIZERS": "OFF",
                "LIB_FMU_TOOLKIT_MINGW_STATIC_RUNTIME": "ON"
            }
        },
        {
            "name": "base-windows-mingw32",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "environment": {
                "PATH": "C:/eng_apps/msys64/mingw32/bin;C:/eng_apps/msys64/usr/bin;$penv{PATH}",
                "PKG_CONFIG_PATH": "C:/eng_apps/msys64/mingw32/lib/pkgconfig",
                "PKG_CONFIG": "C:/eng_apps/msys64/mingw32/bin/pkg-config.exe"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "C:/eng_apps/msys64/mingw32/bin/g++.exe",
                "CMAKE_C_COMPILER": "C:/eng_apps/msys64/mingw32/bin/gcc.exe",
                "CMAKE_MAKE_PROGRAM": "C:/eng_apps/msys64/mingw32/bin/ninja.exe"
            }
        },
        {
            "name": "base-windows-mingw64",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "environment": {
                "PATH": "C:/eng_apps/msys64/mingw64/bin;C:/eng_apps/msys64/usr/bin;$penv{PATH}",
                "PKG_CONFIG_PATH": "C:/eng_apps/msys64/mingw64/lib/pkgconfig",
                "PKG_CONFIG": "C:/eng_apps/msys64/mingw64/bin/pkg-config.exe"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "C:/eng_apps/msys64/mingw64/bin/g++.exe",
                "CMAKE_C_COMPILER": "C:/eng_apps/msys64/mingw64/bin/gcc.exe",
                "CMAKE_MAKE_PROGRAM": "C:/eng_apps/msys64/mingw64/bin/ninja.exe"
            }
        },
        {
            "name": "base-linux",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_C_COMPILER": "/usr/bin/gcc"
            }
        },
        {
            "name": "windows-mingw32-debug",
            "displayName": "Windows MinGW32 Debug",
            "inherits": "base-windows-mingw32",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "windows-mingw32-debug"
            }
        },
        {
            "name": "windows-mingw32-release",
            "displayName": "Windows MinGW32 Release",
            "inherits": "base-windows-mingw32",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "windows-mingw32-release"
            }
        },
        {
            "name": "windows-mingw64-debug",
            "displayName": "Windows MinGW64 Debug",
            "inherits": "base-windows-mingw64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "windows-mingw64-debug"
            }
        },
        {
            "name": "windows-mingw64-release",
            "displayName": "Windows MinGW64 Release",
            "inherits": "base-windows-mingw64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "windows-mingw64-release"
            }
        },
        {
            "name": "linux-mingw-debug",
            "displayName": "Linux/WSL GCC Debug",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "linux-mingw-debug"
            }
        },
        {
            "name": "linux-mingw-release",
            "displayName": "Linux/WSL GCC Release",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "linux-mingw-release"
            }
        },
        {
            "name": "docker-mingw-debug",
            "displayName": "Docker GCC Debug",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "docker-mingw-debug"
            }
        },
        {
            "name": "docker-mingw-release",
            "displayName": "Docker GCC Release",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LIB_FMU_TOOLKIT_PRESET_NAME": "docker-mingw-release"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-mingw32-debug",   "configurePreset": "windows-mingw32-debug"   },
        { "name": "windows-mingw32-release",  "configurePreset": "windows-mingw32-release"  },
        { "name": "windows-mingw64-debug",    "configurePreset": "windows-mingw64-debug"    },
        { "name": "windows-mingw64-release",  "configurePreset": "windows-mingw64-release"  },
        { "name": "linux-mingw-debug",        "configurePreset": "linux-mingw-debug"        },
        { "name": "linux-mingw-release",      "configurePreset": "linux-mingw-release"      },
        { "name": "docker-mingw-debug",       "configurePreset": "docker-mingw-debug"       },
        { "name": "docker-mingw-release",     "configurePreset": "docker-mingw-release"     }
    ],
    "testPresets": [
        { "name": "windows-mingw32-debug",   "configurePreset": "windows-mingw32-debug",   "output": { "outputOnFailure": true } },
        { "name": "windows-mingw32-release",  "configurePreset": "windows-mingw32-release",  "output": { "outputOnFailure": true } },
        { "name": "windows-mingw64-debug",    "configurePreset": "windows-mingw64-debug",    "output": { "outputOnFailure": true } },
        { "name": "windows-mingw64-release",  "configurePreset": "windows-mingw64-release",  "output": { "outputOnFailure": true } },
        { "name": "linux-mingw-debug",        "configurePreset": "linux-mingw-debug",        "output": { "outputOnFailure": true } },
        { "name": "linux-mingw-release",      "configurePreset": "linux-mingw-release",      "output": { "outputOnFailure": true } },
        { "name": "docker-mingw-debug",       "configurePreset": "docker-mingw-debug",       "output": { "outputOnFailure": true } },
        { "name": "docker-mingw-release",     "configurePreset": "docker-mingw-release",     "output": { "outputOnFailure": true } }
    ]
}
