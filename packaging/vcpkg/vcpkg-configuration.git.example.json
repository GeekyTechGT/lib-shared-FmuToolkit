{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg-configuration.schema.json",
    "default-registry": {
        "kind": "builtin",
        "baseline": "<fill-with-your-vcpkg-baseline>"
    },
    "registries": [
        {
            "kind": "git",
            "repository": "<fill-with-your-private-registry-url>",
            "baseline": "<fill-with-registry-commit>",
            "packages": [
                "lib-fmu-toolkit"
            ]
        }
    ]
}
